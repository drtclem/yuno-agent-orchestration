# Copy to .env (make up does this for you). Never commit .env.
# opencode = real agents (needs OPENAI_API_KEY); fake = scripted agents, no key needed
RUNTIME=opencode
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-5.4-mini
# Slack (optional until T20). Create the app from docs/slack-app-manifest.yaml
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
PORT=3000
# Docker sets HOST and WEB_DIR internally; local dev uses loopback and Vite.
HOST=127.0.0.1
# WEB_DIR=/absolute/path/to/apps/web/dist
OPENCODE_URL=http://opencode:4096
DATA_DIR=/data
# Set to 1 only to run tests that call OpenAI/Slack/OpenCode for real
LIVE_TESTS=0
